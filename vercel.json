{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php?__route=/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/public/assets/$1"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*\\.html)",
      "destination": "/public/$1"
    },
    {
      "source": "/((?!api|public|assets).*)",
      "destination": "/public/$1.html"
    }
  ]
}
